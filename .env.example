# ─── Frontend ───────────────────────────────────────────────
# Bo'sh qoldiring — API so'rovlari sahifaning o'z origini ga (`/api/...`)
# yuboriladi va ilova HTTP hamda HTTPS da bir xil ishlaydi.
# Backend alohida domenda bo'lsagina to'ldiring.
VITE_API_URL=

# Alohida backend misoli (HTTPS sahifada faqat HTTPS manzil ishlaydi):
# VITE_API_URL=https://api.sizning-domen.uz

# ─── AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ─── Server ─────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Ishlab chiqarish rejimi uchun: production
NODE_ENV=development

# nginx/Caddy orqasida HTTP -> HTTPS yo'naltirish
FORCE_HTTPS=false

# Ruxsat etilgan cross-origin manzillar (vergul bilan). Bo'sh — barchasiga ruxsat.
CORS_ORIGINS=
